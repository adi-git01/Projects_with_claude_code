# Google AI API Key (Required)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Configuration
# Set to 'true' to enable Google Search Grounding (real-time web data)
# Set to 'false' for testing/development (uses example data, higher quota)
# With grounding: 2-5 RPM, 50-100 RPD, real prices
# Without grounding: 15 RPM, 1500 RPD, example prices
ENABLE_SEARCH_GROUNDING=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Cache Settings
ENABLE_CACHING=true
CACHE_TTL_MINUTES=60

# CORS Settings (Frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
